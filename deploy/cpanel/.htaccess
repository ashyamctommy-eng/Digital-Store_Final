# ==========================================================================
# Digital Hub Shop — production .htaccess for cPanel (HostNin)
#
# Upload this file to the document root of your domain, alongside index.html
# and the _next/ and api/ folders.
#
# NOTE ON THE SPA FALLBACK
# ------------------------
# This site is a Next.js *static export*, not a single-page app. Every route is
# a real directory containing its own index.html
# (e.g. /products/foo/index.html), and Apache's DirectoryIndex serves it
# automatically.
#
# A blanket `RewriteRule ^ index.html [L]` that ignores %{REQUEST_FILENAME}
# would make EVERY url return the homepage and silently destroy deep links and
# SEO. It is deliberately left commented out below. Only enable it if you later
# switch to a genuine client-side-routed SPA build.
# ==========================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html

# --------------------------------------------------------------------------
# 1. Force HTTPS and strip the www prefix
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP -> HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www.example.com -> example.com
  # (Comment this out if you would rather canonicalise TO www.)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- DO NOT ENABLE unless you move to a true SPA build ---
  # RewriteCond %{REQUEST_FILENAME} !-f
  # RewriteRule ^ index.html [L]
</IfModule>

# --------------------------------------------------------------------------
# 2. Trailing slashes
# --------------------------------------------------------------------------
# The build uses trailingSlash:true, so every page is a directory. DirectorySlash
# sends /products/foo to /products/foo/ — correct here. It must stay enabled.
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# --------------------------------------------------------------------------
# 3. Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# 4. Caching
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Content-hashed build output can be cached forever.
  <FilesMatch "\.(js|css|woff2?|ttf|eot|otf|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must always be revalidated so deployments are picked up immediately.
  <FilesMatch "\.(html)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Never cache the payment API responses.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/api/#">
    Header always set Cache-Control "no-store"
  </IfModule>
</IfModule>

# --------------------------------------------------------------------------
# 5. Payment webhook reachability and CORS
# --------------------------------------------------------------------------
# Palplus and NOWPayments call these URLs server-to-server. CORS is a *browser*
# policy and is irrelevant to those calls — the header below exists only so you
# can exercise the endpoints from a browser console while testing.
#
# What genuinely matters for webhooks:
#   * the URL stays public (no auth cookie, no Basic auth)
#   * it answers POST and returns 2xx quickly
#   * your host firewall does not block inbound POSTs from abroad
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/api/(palplus|nowpayments)/webhook#">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, x-nowpayments-sig"
  </If>
</IfModule>

# Answer CORS preflight for the API without touching PHP.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} =OPTIONS
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [R=204,L]
</IfModule>

# --------------------------------------------------------------------------
# 6. Security headers
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Enable once you are certain every asset is HTTPS-only.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --------------------------------------------------------------------------
# 7. Protect secrets and dotfiles
# --------------------------------------------------------------------------
# Block accidental exposure of source-control and config artefacts.
<IfModule mod_rewrite.c>
  RewriteRule ^\.(?!well-known/) - [F,L]
</IfModule>

<FilesMatch "(^\.|\.(env|log|json|md|lock|ts|tsx|map)$|^config\.php$|^package(-lock)?\.json$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# The order ledger, if it ever ends up inside the web root.
RedirectMatch 403 ^/api/data/.*$

# --------------------------------------------------------------------------
# 8. Custom error pages
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# 9. MIME types some cPanel hosts miss
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/font-woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
